# Copy to .env for local runs: node --env-file=.env bin/cli.js run
# In GitHub Actions these are repository secrets instead.

# Required. Your ScrapeUnblocker API key.
SCRAPEUNBLOCKER_KEY=your_key_here

# Destinations: set any of them. With none set, the digest is printed.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
WEBHOOK_URL=

# Notion: the integration secret and the database (id or copied link).
NOTION_TOKEN=
NOTION_DATABASE_ID=
